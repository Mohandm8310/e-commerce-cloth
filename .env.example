# Flask Configuration
SECRET_KEY=stylesphere-super-secret-key-change-in-production-2026
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Database Configuration (MySQL 8+ by default, or SQLite for local zero-config fallback)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/stylesphere_db
# SQLite fallback if MySQL is unavailable: sqlite:///stylesphere.db

# Authentication & OTP Settings
MOCK_OTP=True
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Transactional Email Settings (SMTP / SendGrid / SES)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=StyleSphere Fashion <noreply@stylesphere.com>

# SMS OTP Settings (Optional)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=STYLES

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_stylesphere1234
RAZORPAY_KEY_SECRET=stylesphere_test_secret_5678
RAZORPAY_WEBHOOK_SECRET=stylesphere_webhook_secret_9999
MOCK_RAZORPAY=True

# Application Policies
PRODUCT_UNDO_RETENTION_SECONDS=30
CUSTOMER_SESSION_LIFETIME_DAYS=14
ADMIN_SESSION_LIFETIME_MINUTES=120
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
